# UBPMS backend configuration
# Copy this file to .env (in the backend folder) and fill in your own values.
# Never commit your real .env file.

# --- Server ---
# Port the API listens on (the frontend dev server proxies /api to this port)
PORT=5001
# development or production (development shows detailed error messages)
NODE_ENV=development
# URL of the frontend, allowed by CORS
FRONTEND_URL=http://localhost:3000

# --- MySQL database ---
# Host and port of your MySQL 8 server
DB_HOST=localhost
DB_PORT=3306
# MySQL user and password the app connects with
DB_USER=root
DB_PASSWORD=your_mysql_password
# Database name (npm run migrate creates it if it doesn't exist)
DB_NAME=ubpms

# --- Authentication ---
# Secret used to sign login tokens. Required. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
# How long a login stays valid (e.g. 1h, 7d)
JWT_EXPIRES_IN=7d

# --- File uploads ---
# Folder where uploaded documents are stored (relative to the backend folder)
UPLOAD_DIR=uploads
# Maximum upload size in bytes (10485760 = 10 MB)
MAX_FILE_SIZE=10485760
# How many times a student may resubmit a document
MAX_RESUBMISSIONS=3

# --- Email (optional, for notifications) ---
# Leave SMTP_USER and SMTP_PASS empty to disable email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
